{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: dialogs, opener (including reveal in folder), and drag-and-drop. File I/O happens in Rust.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
